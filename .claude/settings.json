{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run validate)",
      "Bash(npm run roadmap)",
      "Bash(npm run gen)",
      "Bash(npm run gen:*)",
      "Bash(npx vitest:*)",
      "Bash(agent-browser:*)"
    ]
  }
}
