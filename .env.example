# Copy to .env (never commit .env). Used by compose.yaml.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Address and port the game listens on. 0.0.0.0 lets phones on your Wi-Fi join; 127.0.0.1 keeps it on this PC.
BIND_HOST=0.0.0.0
GAME_PORT=8080
# cycle (the weather follows the day, with aurora nights) | overcast | rain | night | aurora
WEATHER=cycle

# How players sign in: legacy | dev | supabase. Without it, compose.yaml uses dev.
#   legacy    names and browser tokens, without sign-in
#   dev       any email, no code, so every tab can be another player. Anyone can sign in as anyone,
#             so a production server (NODE_ENV=production) refuses it; compose.yaml lets it run on
#             this PC with ALLOW_DEV_AUTH=1. Never put this setup on the internet.
#   supabase  an email and a 6-digit code (or Google and Apple) through Supabase Auth; needs the two
#             settings below
# AUTH_MODE=dev
# With supabase: the project's address and its publishable key. Both are public (every browser gets
# them from /auth-config); the server refuses to start with a secret key (sb_secret_... or a
# service_role JWT). Try it with a Supabase project of your own; what the project needs (emails that
# show the code) is in docs/OPERATIONS.md, "Sign-in (Supabase)".
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google and Apple on the sign-in card, once your project has them set up (docs/OPERATIONS.md, "Google
# and Apple"; your project's Redirect URLs must include this game's address, like http://localhost:8080).
# In dev mode they only show their buttons, which say they need a Supabase project.
# AUTH_PROVIDERS=google,apple
